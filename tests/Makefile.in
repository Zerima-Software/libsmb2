@AMDEP_TRUE@@am__fastdepCC_FALSE@	DEPDIR=$(DEPDIR) $(CCDEPMODE) $(depcomp) @AMDEPBACKSLASH@
@am__fastdepCC_FALSE@	$(AM_V_CC@am__nodep@)$(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(ld_sockerr_CFLAGS) $(CFLAGS) -c -o ld_sockerr-ld_sockerr.o `test -f 'ld_sockerr.c' || echo '$(srcdir)/'`ld_sockerr.c

