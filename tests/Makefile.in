@am__fastdepCC_TRUE@	$(AM_V_CC)$(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(ld_sockerr_CFLAGS) $(CFLAGS) -MT ld_sockerr-ld_sockerr.obj -MD -MP -MF $(DEPDIR)/ld_sockerr-ld_sockerr.Tpo -c -o ld_sockerr-ld_sockerr.obj `if test -f 'ld_sockerr.c'; then $(CYGPATH_W) 'ld_sockerr.c'; else $(CYGPATH_W) '$(srcdir)/ld_sockerr.c'; fi`
@am__fastdepCC_TRUE@	$(AM_V_at)$(am__mv) $(DEPDIR)/ld_sockerr-ld_sockerr.Tpo $(DEPDIR)/ld_sockerr-ld_sockerr.Po
@AMDEP_TRUE@@am__fastdepCC_FALSE@	$(AM_V_CC)source='ld_sockerr.c' object='ld_sockerr-ld_sockerr.obj' libtool=no @AMDEPBACKSLASH@
